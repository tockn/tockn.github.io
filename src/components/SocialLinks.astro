---

<div class="social-links">
  {
    socials.map((s) => (
      <a
        href={s.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={s.label}
        class="social-link"
      >
        <Fragment set:html={s.icon} />
      </a>
    ))
  }
</div>

<style>
  .social-links {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .social-link {
    color: var(--color-text-sub);
    transition: color 0.2s ease;
    display: flex;
    align-items: center;
  }

  .social-link:hover {
    color: var(--color-accent);
  }

  .social-link :global(svg) {
    width: 20px;
    height: 20px;
  }
</style>
